# POCO F4 / Redmi K40S: 1080x2400, central camera cutout.
AERA_MAINTAINER := olzhas0986
AERA_UI_ADAPTIVE_RESOLUTION := true
AERA_FRAMERATE := 120
AERA_SCREEN_H := 2400
AERA_STATUS_H := 115
AERA_HIDE_NOTCH := 1
AERA_CLOCK_POS := 1
AERA_STATUS_INDENT_LEFT := 56
AERA_STATUS_INDENT_RIGHT := 48
AERA_ALLOW_DISABLE_NAVBAR := 0
AERA_USE_GREEN_LED := 0

# Munch uses recovery-as-boot and HIDL boot control, with no recovery partition.
AERA_FORCE_PREBUILT_KERNEL := 1
AERA_USE_AIDL_BOOT_CONTROL := 0
AERA_AB_DEVICE_WITH_RECOVERY_PARTITION := 0
AERA_QUICK_BACKUP_LIST := /boot;/data;
AERA_DYNAMIC_FULL_SIZE := 9126805504
AERA_ENABLE_LPTOOLS := 1
AERA_ENABLE_ALL_PARTITION_TOOLS := 1
AERA_USE_DMCTL := 1

# Keep formatting and emulated storage consistent with the existing FBE fstab.
AERA_UNBIND_SDCARD_F2FS := 1
AERA_WIPE_METADATA_AFTER_DATAFORMAT := 1
AERA_BIND_MOUNT_SDCARD_ON_FORMAT := 1
AERA_UNMOUNT_SDCARDS_BEFORE_REBOOT := 1
AERA_LOOP_DEVICE_ERRORS_TO_LOG := 1
AERA_DISABLE_ORS_AUTO_REBOOT := 1

# No validated GPU/WLAN stack or matching offline root payload for this 4.19 kernel.
AERA_EXCLUDE_OFFLINE_ROOT_PROVIDERS := 1
